{
  "expo": {
    "name": "IRCS Management",
    "slug": "ircs-management-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ircs-logo-padded.png",
    "scheme": "ircsmanagement",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stackenzo.ircsmanagement",
      "infoPlist": {
        "NSCameraUsageDescription": "IRCS Management uses the camera to capture employee face-enrollment images.",
        "NSPhotoLibraryUsageDescription": "IRCS Management can attach a profile photo or enrollment image from your photo library."
      }
    },
    "android": {
      "icon": "./assets/images/ircs-logo-padded.png",
      "package": "com.stackenzo.ircsmanagement",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ircs-logo-padded.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "IRCS Management uses the camera to capture employee face-enrollment images."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "IRCS Management can attach a profile photo from your photo library."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "IRCS Management uses the microphone to record employee name audio."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1eba046e-208e-4dd9-9594-738a33c8dc24"
      }
    },
    "owner": "chaithu_2001"
  }
}